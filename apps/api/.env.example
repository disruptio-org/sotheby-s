# Postgres. Matches docker-compose.yml (host port 5433 to avoid clashing with a
# local Postgres on 5432).
DATABASE_URL="postgresql://backoffice:backoffice@localhost:5433/backoffice?schema=public"

# Signs the session cookie. Any 32+ character random string.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Encrypts provider API keys at rest. Must decode to exactly 32 bytes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change-me-base64-32-bytes"

HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# The browser origin allowed to call this API with credentials.
WEB_ORIGIN="http://localhost:5173"

SESSION_TTL_HOURS=12

# Workflow execution
RUN_CONCURRENCY=2
RUN_STEP_TIMEOUT_MS=120000

# Run workflows against a stub instead of a real provider. Leave this on until
# you have added an API key in Definições — with it off, a run without a key
# fails fast instead of silently costing nothing.
RUN_SIMULATE=true

# Outgoing mail. docker-compose.yml runs Mailpit, which accepts anything and
# delivers nowhere: read the invitations at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="AI Back Office <nao-responder@sothebysrealty.pt>"

# How long an invitation link stays good.
INVITE_TTL_HOURS=72

# Password recovery: how long a reset link lasts, how many an account may ask
# for in an hour, and how many one source address may ask for in an hour.
RESET_TTL_MINUTES=60
RESET_MAX_PER_ACCOUNT=3
RESET_MAX_PER_IP=10

# Password given to the seeded active users.
SEED_PASSWORD="back-office-2026"
